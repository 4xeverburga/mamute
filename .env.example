# Mamute — local setup template.
#
# `.env` is NOT tracked (see .gitignore): copy this file to `.env` and set
# the values for the run you are doing. These are read from the environment
# by whatever starts the app; never hardcode them in a page or a script.
# NEVER put real secrets (OAuth keys, API tokens) in a file you commit.

# Admin account the e2e flows log in with. Mamute seeds a moderator at
# first boot; the bootstrap step rotates it to this password.
MAMUTE_ADMIN_USER=admin@mamute.dev
MAMUTE_ADMIN_PASSWORD=CHANGE_ME
