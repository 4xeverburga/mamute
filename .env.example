# Mamute sample — eval environment template.
#
# NOTE: `.env` itself is TRACKED in this repo on purpose (see .gitignore):
# its values are synthetic and deterministic, so a bare checkout boots with
# the same accounts as every other researcher's.  NEVER put real secrets
# (OAuth keys, API tokens) in a tracked .env — those belong in gitignored
# files only.
#
# These values reach the app through `compose.yaml` and the e2e flows; the
# flows read them from the environment — never hardcode them.
#
# Host ports are NOT configured here: `compose.yaml` publishes
# `${BENCH_HTTP_PORT:-8090}` / `${BENCH_DB_PORT:-5434}`, and the harness
# exports both before every `compose` call so runs never collide.

# Admin account the e2e flows log in with. Mamute seeds a moderator at
# first boot; the one-shot `bootstrap` service rotates it to this password.
MAMUTE_ADMIN_USER=admin@mamute.dev
MAMUTE_ADMIN_PASSWORD=CHANGE_ME
